# Record with: vhs demo/demo.tape   (run from the repository root)
Output demo/demo.gif

Set Shell "bash"
Set FontSize 18
Set Width 1300
Set Height 430
Set Padding 24
Set Margin 36
Set MarginFill "#181825"
Set BorderRadius 14
Set WindowBar Colorful
Set Theme "Catppuccin Mocha"
Set TypingSpeed 0

Hide
Type "export PS1=''"
Enter
Show

Type "demo/demo.sh"
Enter
Sleep 25s
