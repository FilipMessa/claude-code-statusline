# Record with: vhs demo/setup.tape   (run from the repository root)
Output demo/setup.gif

Set Shell "bash"
Set FontSize 18
Set Width 1300
Set Height 600
Set Padding 24
Set Margin 36
Set MarginFill "#181825"
Set BorderRadius 14
Set WindowBar Colorful
Set Theme "Catppuccin Mocha"
Set TypingSpeed 0

Hide
Type "export PS1=''"
Enter
Show

Type "demo/setup.sh"
Enter
Sleep 22s
